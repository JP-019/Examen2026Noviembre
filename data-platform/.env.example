# =====================================================================
# Variables de entorno - PLANTILLA (sin credenciales reales)
# Copiar a .env y completar en el equipo local. .env NO se versiona.
# =====================================================================

# --- Fuente (SQL Server transaccional, solo lectura) ---
SOURCE_SERVER=localhost
SOURCE_DATABASE=Venta
SOURCE_DRIVER=ODBC Driver 18 for SQL Server
SOURCE_TRUSTED_CONNECTION=yes
# auto solo confia en el certificado autofirmado si el servidor es localhost.
SOURCE_TRUST_SERVER_CERTIFICATE=auto
# Si se usa usuario tecnico en lugar de autenticacion de Windows:
# SOURCE_USER=
# SOURCE_PASSWORD=

# --- Plataforma (staging + DW) ---
DW_SERVER=localhost
DW_DATABASE=DataPlatform
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_TRUSTED_CONNECTION=yes
# auto solo confia en el certificado autofirmado si el servidor es localhost.
DW_TRUST_SERVER_CERTIFICATE=auto
# DW_USER=
# DW_PASSWORD=

# --- Puertos (referencia para levantar cada servicio) ---
CATALOG_PORT=8001
CORE_API_PORT=8000
ML_SERVICE_PORT=8002
GENAI_SERVICE_PORT=8003
ALERTING_SERVICE_PORT=8004
DASHBOARD_PORT=8501

# --- URLs entre servicios (solo HTTP interno) ---
CORE_API_URL=http://localhost:8000
ML_URL=http://localhost:8002
GENAI_URL=http://localhost:8003
GENAI_HTTP_TIMEOUT=10
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_HTTP_TIMEOUT=60
# Limite de filas por pagina en core-api (1-1000)
CORE_API_MAX_PAGE_SIZE=200

# --- ETL ---
ETL_BATCH_SIZE=1000
ETL_OVERLAP_DAYS=1
ETL_LOG_LEVEL=INFO

# --- Servicio ML ---
# Carpeta de artefactos; en pruebas conviene aislarla para no pisar la version vigente
# ML_ARTIFACTS_DIR=C:\ruta\a\artefactos
ML_MIN_TRAIN_PERIODS=6
ML_MIN_TEST_PERIODS=2
ML_TEST_FRACTION=0.25

# --- Servicio GenAI ---
GENAI_HTTP_TIMEOUT=10
# El asistente NO usa API keys ni LLM externo: solo consultas aprobadas a core-api.

# --- Servicio de alertas ---
# SQLite local con alertas y entregas; ignorado por git
# ALERT_DB_PATH=C:\ruta\a\alerts.db
ALERT_HTTP_TIMEOUT=10
ALERT_VENTAS_MIN=1000
ALERT_TICKET_MIN=200
ALERT_CAIDA_PCT=15
ALERT_MAE_MAX=500
ALERT_RECHAZOS_MAX=10

# --- Dashboard ---
DASHBOARD_HTTP_TIMEOUT=10
