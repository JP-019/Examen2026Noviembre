# Variables de entorno del bot de Telegram (ejemplo).
# Copiar a .env y completar con valores reales. NUNCA versionar .env.

# Token del bot entregado por BotFather.
BOT_TOKEN=

# ID(s) de Telegram del dueño/encargados que recibirán los pedidos.
# Escribir /miid al bot para obtener el ID. Se pueden separar varios por coma.
ADMIN_CHAT_ID=

# Panel web de pedidos (dashboard).
DASHBOARD_PORT=3000
DASHBOARD_TOKEN=

# Usuario del bot para el enlace de compartir (sin @).
BOT_USERNAME=
